{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KITFORGE_COPY_PLUGIN_AFTER_BUILD": "OFF"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "description": "Fast dev builds — Standalone, no plugin install",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KITFORGE_BUILD_UI": "ON"
      }
    },
    {
      "name": "ninja-debug-devui",
      "displayName": "Ninja Debug + Vite dev server",
      "inherits": "ninja-debug",
      "cacheVariables": {
        "KITFORGE_USE_DEV_SERVER": "ON",
        "KITFORGE_BUILD_UI": "OFF"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KITFORGE_BUILD_UI": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "standalone-debug",
      "displayName": "KitForge Standalone (Debug)",
      "configurePreset": "ninja-debug",
      "targets": ["KitForge_Standalone"]
    },
    {
      "name": "standalone-release",
      "displayName": "KitForge Standalone (Release)",
      "configurePreset": "ninja-release",
      "targets": ["KitForge_Standalone"]
    },
    {
      "name": "all-debug",
      "displayName": "All targets (Debug)",
      "configurePreset": "ninja-debug"
    }
  ]
}
