#!/usr/bin/env bash
# Build an unsigned KitForge Standalone DMG for distribution (MVP default).
#
# Signing/notarization is opt-in for later — set RELEASE_SIGN=1 and fill .env.release.
#
# Optional:
#   KITFORGE_VERSION   Overrides CMake project() version in the DMG name
#   RELEASE_SIGN=1     Enable Developer ID sign + notarize (requires .env.release)
#
# Usage:
#   scripts/release
#
# Output:
#   build-release/KitForge_artefacts/Release/Standalone/KitForge.app
#   dist/KitForge-<version>.dmg

set -euo pipefail

cd "$(dirname "$0")/.."
ROOT=$(pwd)

BUILD_DIR=${BUILD_DIR:-build-release}
DIST_DIR=${DIST_DIR:-dist}
APP_NAME="KitForge"
APP_PATH="${BUILD_DIR}/KitForge_artefacts/Release/Standalone/${APP_NAME}.app"
ENTITLEMENTS="${ROOT}/Resources/${APP_NAME}.entitlements"

log()  { printf '\033[36m▶\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m %s\n' "$*"; }
fail() { printf '\033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }

[[ "$(uname)" == "Darwin" ]] || fail "scripts/release only runs on macOS."

if [[ -f .env.release ]]; then
    log "Loading .env.release"
    set -a
    # shellcheck disable=SC1091
    source .env.release
    set +a
fi

SIGN_RELEASE=false
if [[ "${RELEASE_SIGN:-}" == "1" ]]; then
    SIGN_RELEASE=true
    : "${DEVELOPER_ID_APPLICATION:?Set DEVELOPER_ID_APPLICATION}"
    : "${APPLE_ID:?Set APPLE_ID}"
    : "${APPLE_TEAM_ID:?Set APPLE_TEAM_ID}"
    : "${APPLE_APP_PASSWORD:?Set APPLE_APP_PASSWORD}"
    [[ -f "${ENTITLEMENTS}" ]] || fail "Missing entitlements at ${ENTITLEMENTS}"
fi

if ! command -v create-dmg >/dev/null 2>&1; then
    warn "create-dmg not found — installing via Homebrew..."
    brew install create-dmg
fi

if ! command -v npm >/dev/null 2>&1; then
    fail "npm not found — install Node.js for the React UI build."
fi

VERSION="${KITFORGE_VERSION:-$(awk '/^project\(KitForge VERSION/ {print $3}' CMakeLists.txt | tr -d ')')}"
[[ -n "${VERSION}" ]] || fail "Could not resolve project version."
log "Building ${APP_NAME} ${VERSION} Standalone (unsigned MVP)"

DEFAULT_OSX_ARCH="arm64;x86_64"
CMAKE_ARGS=(
    -B "${BUILD_DIR}"
    -G Ninja
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_OSX_ARCHITECTURES="${CMAKE_OSX_ARCHITECTURES:-${DEFAULT_OSX_ARCH}}"
    -DKITFORGE_BUILD_UI=ON
    -DKITFORGE_USE_DEV_SERVER=OFF
    -DKITFORGE_COPY_PLUGIN_AFTER_BUILD=OFF
)

log "Configuring (${BUILD_DIR})"
cmake "${CMAKE_ARGS[@]}"

log "Building Release Standalone (arch: ${CMAKE_OSX_ARCHITECTURES:-${DEFAULT_OSX_ARCH}})"
cmake --build "${BUILD_DIR}" --target KitForge_Standalone

[[ -d "${APP_PATH}" ]] || fail "Build did not produce ${APP_PATH}"

UI_DEST="${APP_PATH}/Contents/Resources/ui/dist"
if [[ ! -f "${UI_DEST}/index.html" ]]; then
    log "UI bundle missing — copying ui/dist"
    (cd ui && npm ci && npm run build)
    rm -rf "${UI_DEST}"
    mkdir -p "$(dirname "${UI_DEST}")"
    cp -R ui/dist "${UI_DEST}"
fi

if [[ "${SIGN_RELEASE}" == true ]]; then
    SIGN_ID="${DEVELOPER_ID_APPLICATION}"
    log "Codesigning with: ${SIGN_ID}"

    sign_one() {
        codesign --force \
            --options=runtime \
            --timestamp \
            --entitlements "${ENTITLEMENTS}" \
            --sign "${SIGN_ID}" \
            "$1"
    }

    log "Signing nested binaries"
    while IFS= read -r -d '' f; do
        if file "$f" 2>/dev/null | grep -q 'Mach-O'; then
            if [[ "$f" != "${APP_PATH}/Contents/MacOS/${APP_NAME}" ]]; then
                sign_one "$f" || true
            fi
        fi
    done < <(find "${APP_PATH}" -type f -print0)

    log "Signing main bundle"
    sign_one "${APP_PATH}"
    codesign --verify --verbose=2 --strict "${APP_PATH}"

    NOTARIZE_ZIP="${BUILD_DIR}/${APP_NAME}-notarize.zip"
    log "Zipping for notarytool → ${NOTARIZE_ZIP}"
    rm -f "${NOTARIZE_ZIP}"
    /usr/bin/ditto -c -k --keepParent "${APP_PATH}" "${NOTARIZE_ZIP}"

    log "Submitting to notary service (may take several minutes)"
    xcrun notarytool submit "${NOTARIZE_ZIP}" \
        --apple-id "${APPLE_ID}" \
        --team-id "${APPLE_TEAM_ID}" \
        --password "${APPLE_APP_PASSWORD}" \
        --wait

    log "Stapling notarization ticket"
    xcrun stapler staple "${APP_PATH}"
    xcrun stapler validate "${APP_PATH}"
else
    log "Skipping codesign and notarization (MVP unsigned build)"
fi

mkdir -p "${DIST_DIR}"
DMG_PATH="${DIST_DIR}/${APP_NAME}-${VERSION}.dmg"
rm -f "${DMG_PATH}"

log "Creating DMG → ${DMG_PATH}"
create-dmg \
    --volname "${APP_NAME} ${VERSION}" \
    --window-pos 200 120 \
    --window-size 640 380 \
    --icon-size 96 \
    --icon "${APP_NAME}.app" 160 180 \
    --hide-extension "${APP_NAME}.app" \
    --app-drop-link 480 180 \
    --no-internet-enable \
    "${DMG_PATH}" \
    "${APP_PATH}"

if [[ "${SIGN_RELEASE}" == true ]]; then
    log "Signing DMG"
    codesign --force --timestamp --sign "${SIGN_ID}" "${DMG_PATH}"

    log "Notarizing DMG"
    xcrun notarytool submit "${DMG_PATH}" \
        --apple-id "${APPLE_ID}" \
        --team-id "${APPLE_TEAM_ID}" \
        --password "${APPLE_APP_PASSWORD}" \
        --wait

    xcrun stapler staple "${DMG_PATH}"
    xcrun stapler validate "${DMG_PATH}"
fi

log "Done."
printf '\nArtifacts:\n  %s\n  %s\n' "${APP_PATH}" "${DMG_PATH}"
if [[ "${SIGN_RELEASE}" != true ]]; then
    warn "Unsigned build — users may need Right-click → Open the first time on macOS."
fi
